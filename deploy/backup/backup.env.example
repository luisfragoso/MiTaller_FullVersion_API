# /etc/mitaller/backup.env (root:root 600)
# Cloudflare R2: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=/var/backups/mitaller-restic
RESTIC_PASSWORD_FILE=/etc/mitaller/restic.pass
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# healthchecks.io ping URL; empty = no alerts
HC_URL=
